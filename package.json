{
  "name": "codex-web-bridge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:binary": "pnpm build && node scripts/build-binary.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @cwb/server dev",
    "cwb": "node apps/server/dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "bun": "^1.3.14",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
