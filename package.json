{
  "name": "codex-web-bridge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:binary": "pnpm build && node scripts/build-pkg-binary.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @cwb/server dev",
    "cwb": "node apps/server/dist/cli.js"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@types/node": "^22.15.0",
    "@yao-pkg/pkg": "6.21.0",
    "better-sqlite3": "^11.9.1",
    "esbuild": "^0.28.1",
    "prettier": "^3.6.2",
    "ssh2": "^1.17.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
