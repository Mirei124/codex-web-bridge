[Unit]
Description=Codex Web Bridge
After=network-online.target

[Service]
Type=simple
User=codex-web-bridge
# Initialize this state directory once with the intended password and public
# HTTP/HTTPS origin before enabling the unit; subsequent starts reuse config.json.
Environment=CWB_DATA_DIR=/var/lib/codex-web-bridge
ExecStart=/usr/local/bin/codex-web-bridge start --foreground
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/codex-web-bridge

[Install]
WantedBy=multi-user.target
