# Recommended IP-only deployment: generate a self-signed certificate whose SAN
# includes the public IP, then point Caddy at the certificate and key directly.
# Example:
# openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
#   -keyout /etc/caddy/certs/YOUR_PUBLIC_IP.key \
#   -out /etc/caddy/certs/YOUR_PUBLIC_IP.crt \
#   -subj "/CN=YOUR_PUBLIC_IP" \
#   -addext "subjectAltName=IP:YOUR_PUBLIC_IP"
{
  http_port 8080
  https_port 8443
}

http://YOUR_PUBLIC_IP {
  redir https://YOUR_PUBLIC_IP:8443{uri} 308
}

:8443 {
  tls /etc/caddy/certs/YOUR_PUBLIC_IP.crt /etc/caddy/certs/YOUR_PUBLIC_IP.key
  encode zstd gzip
  reverse_proxy 127.0.0.1:3210 {
    header_up X-Forwarded-Proto https
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
}
