# Recommended public deployment: initialize codex-web-bridge with this site's
# HTTPS origin, keep its default 127.0.0.1 listener, and let Caddy be the only
# public-facing process. Direct local HTTP does not require this proxy.
bridge.example.com {
  encode zstd gzip
  reverse_proxy 127.0.0.1:3210 {
    header_up X-Forwarded-Proto https
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
  }
}
